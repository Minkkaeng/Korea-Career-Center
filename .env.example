# EmailJS 설정 (Apply.tsx 문의 폼 연동용)
# https://www.emailjs.com/ 에 가입 후 대시보드에서 아래 정보들을 확인하여 기입해주세요.
# 이 파일을 복사하여 .env 로 이름을 변경한 후 사용하세요.

# 1. EmailJS Service ID (Email Services 탭에서 확인)
VITE_APP_EMAILJS_SERVICE_ID=your_service_id_here

# 2. EmailJS Template ID (Email Templates 탭에서 확인)
VITE_APP_EMAILJS_TEMPLATE_ID=your_template_id_here

# 3. EmailJS Public Key (Account > API Keys 탭에서 확인)
VITE_APP_EMAILJS_PUBLIC_KEY=your_public_key_here
